{
    "name": "davidpetrasek/chat-bundle",
    "type": "symfony-bundle",
    "description": "Provides user-to-user messaging features for your Symfony application.",
    "keywords": ["symfony", "message", "messaging"],
    "homepage": "https://github.com/FriendsOfSymfony/FOSChatBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Thibault Duplessis",
            "email": "thibault.duplessis@gmail.com",
            "homepage": "http://ornicar.github.com"
        },
        {
            "name": "FriendsOfSymfony Community",
            "homepage": "https://github.com/friendsofsymfony/FOSChatBundle/contributors"
        }
    ],
    
    "autoload": {
        "psr-4": {
            "FOS\\ChatBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "symfony/console": ">=7.4",
        "symfony/framework-bundle": ">=7.4",
        "symfony/form": ">=7.4",
        "symfony/maker-bundle": ">=1.67.0",
        "symfony/security-bundle": ">=7.4",
        "symfony/string": ">=7.4",
        "symfony/twig-bundle": ">=7.4",
        "symfony/validator": ">=7.4",
        "symfony/yaml": ">=7.4",
        "doctrine/orm": ">=3.3",
        "symfony/http-client": ">=7.4"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/mongodb-odm-bundle": "^5.5",
        "omines/akismet": "^1.0"
    },
    "require-dev": {
        "rector/rector": "^2.0",
        "symfony/test-pack": "^1.2",
        "phpunit/phpunit": "^13.2"
    }
}
